---
import Layout from "../layout/Layout.astro";

const correoContacto = "carmeetingsv@gmail.com";
---

<Layout
    title="Suscríbete | Car Meeting SV"
    description="Recibe en tu correo las novedades de eventos, clubes y pistas de El Salvador."
    image="/images/hero-image.webp"
>
    <section class="suscripcion-hero" aria-labelledby="titulo-suscripcion">
        <div class="hero-contenido">
            <div class="suscripcion-panel">
                <span class="etiqueta">Car Meeting SV · El Salvador</span>
                <h1 id="titulo-suscripcion">No te pierdas ningún evento</h1>
                <p class="introduccion">
                    Suscríbete y recibe en tu correo los próximos car meets,
                    car shows y track days de El Salvador.
                </p>
                <form
                    class="form-suscripcion"
                    id="form-suscripcion"
                    data-correo-contacto={correoContacto}
                >
                    <label class="solo-lectores" for="correo-suscripcion">
                        Correo electrónico
                    </label>
                    <input
                        id="correo-suscripcion"
                        name="correo"
                        type="email"
                        placeholder="tucorreo@ejemplo.com"
                        autocomplete="email"
                        required
                    />
                    <button type="submit">Suscribirme</button>
                </form>
                <p class="nota">
                    Solo recibirás información de eventos. Puedes cancelar cuando quieras.
                </p>
                <p class="estado" id="estado-suscripcion" role="status" aria-live="polite"></p>
            </div>
        </div>
    </section>

    <section class="beneficios" aria-labelledby="titulo-beneficios">
        <div class="beneficios-contenido">
            <h2 id="titulo-beneficios">¿Qué recibirás?</h2>
            <div class="beneficios-grid">
                <article class="beneficio">
                    <span class="beneficio-numero" aria-hidden="true">01</span>
                    <h3>Calendario de eventos</h3>
                    <p>Fechas, lugares y costos de los próximos eventos.</p>
                </article>
                <article class="beneficio">
                    <span class="beneficio-numero" aria-hidden="true">02</span>
                    <h3>Noticias</h3>
                    <p>Las novedades de la comunidad automotriz salvadoreña.</p>
                </article>
                <article class="beneficio">
                    <span class="beneficio-numero" aria-hidden="true">03</span>
                    <h3>Pistas y clubes</h3>
                    <p>Nuevas pistas, autódromos y clubes que se suman al sitio.</p>
                </article>
            </div>
        </div>
    </section>
</Layout>

<script>
    const form = document.querySelector<HTMLFormElement>("#form-suscripcion");
    const emailInput = document.querySelector<HTMLInputElement>("#correo-suscripcion");
    const estado = document.querySelector<HTMLElement>("#estado-suscripcion");

    if (form && emailInput && estado) form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const correoContacto = form.dataset.correoContacto;
        if (!correoContacto) {
            estado.textContent = "No fue posible preparar la solicitud. Inténtalo más tarde.";
            return;
        }
        const subject = encodeURIComponent("Quiero suscribirme a Car Meeting SV");
        const body = encodeURIComponent(
            `Quiero recibir novedades de Car Meeting SV en este correo: ${emailInput.value.trim()}`
        );

        estado.textContent =
            "Se abrirá tu aplicación de correo para completar la solicitud.";
        window.location.href = `mailto:${correoContacto}?subject=${subject}&body=${body}`;
    });
</script>

<style>
    .suscripcion-hero {
        display: grid;
        min-height: 24rem;
        place-items: center;
        padding: 3.5rem 1.5rem;
        background:
            linear-gradient(110deg, rgb(20 15 16 / 0.82), rgb(20 15 16 / 0.42)),
            url("/images/hero-image.webp") center 55% / cover,
            var(--cape-storm);
        border-block: 1px solid rgb(247 240 236 / 0.12);
    }

    .hero-contenido {
        width: min(100%, 48rem);
    }

    .suscripcion-panel {
        padding: clamp(1.5rem, 5vw, 2.75rem);
        border: 1px solid rgb(247 240 236 / 0.32);
        border-radius: 0.75rem;
        background: rgb(33 23 24 / 0.9);
        box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.35);
        text-align: center;
        backdrop-filter: blur(8px);
    }

    .etiqueta {
        display: inline-block;
        margin-bottom: 0.75rem;
        color: #e5aaa5;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h1 {
        max-width: 40rem;
        margin: 0 auto 0.75rem;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.08;
        letter-spacing: -0.04em;
    }

    .introduccion {
        max-width: 36rem;
        margin: 0 auto;
        color: rgb(247 240 236 / 0.8);
        font-size: 1.05rem;
    }

    .form-suscripcion {
        display: flex;
        gap: 0.75rem;
        max-width: 34rem;
        margin: 1.5rem auto 0;
    }

    .form-suscripcion input {
        min-width: 0;
        flex: 1;
        padding: 0.85rem 1rem;
        border: 1px solid rgb(247 240 236 / 0.35);
        border-radius: 0.35rem;
        background: rgb(247 240 236 / 0.08);
        color: var(--vintage-charm);
        font: inherit;
    }

    .form-suscripcion input::placeholder {
        color: rgb(247 240 236 / 0.55);
    }

    .form-suscripcion input:focus-visible,
    .form-suscripcion button:focus-visible {
        outline: 2px solid #e5aaa5;
        outline-offset: 3px;
    }

    .form-suscripcion button {
        padding: 0.85rem 1.25rem;
        border: 1px solid var(--all-systems-red);
        border-radius: 0.35rem;
        background: var(--all-systems-red);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .form-suscripcion button:hover {
        border-color: #8d0202;
        background: #8d0202;
    }

    .nota {
        margin-top: 1rem;
        color: rgb(247 240 236 / 0.66);
        font-size: 0.85rem;
    }

    .estado {
        min-height: 1.4rem;
        margin-top: 0.4rem;
        color: #e5aaa5;
        font-size: 0.9rem;
    }

    .beneficios {
        padding: 3rem 1.5rem 4rem;
    }

    .beneficios-contenido {
        max-width: 72rem;
        margin: 0 auto;
    }

    .beneficios h2 {
        margin-bottom: 1.5rem;
        font-size: clamp(1.7rem, 3vw, 2.1rem);
        letter-spacing: -0.025em;
    }

    .beneficios-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
    }

    .beneficio {
        position: relative;
        min-height: 11rem;
        padding: 1.6rem;
        overflow: hidden;
        border: 1px solid rgb(247 240 236 / 0.2);
        border-radius: 0.5rem;
        background: linear-gradient(145deg, rgb(60 71 85 / 0.65), rgb(33 23 24 / 0.3));
        
        &:hover{
            transform: translateY(-4px);
            border-color: rgb(224 52 44 / 0.6);
        }
    }

    .beneficio::before {
        position: absolute;
        top: -1px;
        left: 1.6rem;
        width: 4rem;
        height: 3px;
        background: var(--all-systems-red);
        content: "";
    }

    .beneficio-numero {
        display: block;
        margin-bottom: 0.65rem;
        color: #e5aaa5;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
    }

    .beneficio h3 {
        margin-bottom: 0.6rem;
        font-size: 1.4rem;
        line-height: 1.2;
    }

    .beneficio p {
        color: rgb(247 240 236 / 0.72);
    }

    .solo-lectores {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        clip-path: inset(50%);
    }

    @media (max-width: 700px) {
        .suscripcion-hero {
            min-height: 22rem;
            padding-block: 2.5rem;
        }

        .beneficios-grid {
            grid-template-columns: 1fr;
        }

        .beneficio {
            min-height: auto;
        }
    }

    @media (max-width: 480px) {
        .suscripcion-panel {
            padding: 1.5rem 1.1rem;
        }

        .form-suscripcion {
            flex-direction: column;
        }

        .form-suscripcion button {
            width: 100%;
        }

        .beneficios {
            padding-top: 2.5rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .form-suscripcion button {
            transition: none;
        }
    }
</style>