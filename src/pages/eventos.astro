        padding: 0.7rem 1rem;
        border: 1px solid rgb(247 240 236 / 0.2);
        border-radius: 6px;
        background-color: var(--cape-storm, #3c4755);
        color: var(--vintage-charm, #f7f0ec);
        color-scheme: dark;
        cursor: pointer;
    }

    .lista {
        list-style: none;
        border-bottom: 1px solid var(--space-convoy, #637687);
    }

    .evento {
        display: grid;
        grid-template-columns: 4.5rem 7rem 1fr auto;
        gap: 1.5rem;
        align-items: center;
        padding: 1.5rem 0;
        border-top: 1px solid var(--space-convoy, #637687);
    }

    .evento[hidden],
