    }

    .fecha span {
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        color: var(--vintage-charm-medio, #c5b1a6);
    }

    .fecha b {
        font-size: 2.25rem;
        font-weight: 700;
    }

    .miniatura {
        width: 7rem;
        aspect-ratio: 1;
        border: 1px solid rgb(247 240 236 / 0.12);
        border-radius: 8px;
        background:
            var(--img, linear-gradient(transparent, transparent)) center / cover,
            linear-gradient(145deg, var(--a), var(--b));
    }

    .tipo {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #e0342c;
    }

    .info h3 {
        margin: 0.15rem 0 0.25rem;
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .detalles {
        font-size: 0.95rem;
        color: var(--vintage-charm-medio, #c5b1a6);
    }

    .mas-info {
        padding: 0.6rem 1.25rem;
        border: 2px solid var(--space-convoy, #637687);
        border-radius: 4px;
        color: inherit;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;
    }

    .mas-info:hover {
        border-color: var(--all-systems-red, #b00303);
        background-color: var(--all-systems-red, #b00303);
    }

    .banda {
        margin-inline: calc(50% - 50vw);
        padding: 1.75rem max(1.5rem, calc((100vw - 64rem) / 2 + 1.5rem));
        background: linear-gradient(
            90deg,
            var(--all-systems-red, #b00303),
            var(--cape-storm, #3c4755)
        );
        color: #fff;
        list-style: none;
    }

    .banda p {
        font-size: clamp(1.25rem, 3vw, 1.75rem);
