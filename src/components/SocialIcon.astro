---
interface Props {
    platform:
        | "Facebook"
        | "Instagram"
        | "X"
        | "TikTok"
        | "Threads"
        | "YouTube"
        | "Sitio web";
}

const { platform } = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
>
    {platform === "Facebook" && (
        <path d="M7 10v4h3v7h4v-7h3l1-4h-4v-2a1 1 0 0 1 1-1h3V3h-3a5 5 0 0 0-5 5v2H7" />
    )}
    {platform === "Instagram" && (
        <>
            <path d="M3 7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7" />
            <path d="M8.5 12a3.5 3.5 0 1 0 7 0a3.5 3.5 0 0 0-7 0" />
            <path d="M17 7v.01" />
        </>
    )}
    {platform === "X" && (
        <>
            <path d="M4 4l11.733 16H20L8.267 4H4" />
            <path d="m4 20 6.768-6.768m2.46-2.46L20 4" />
        </>
    )}
    {platform === "TikTok" && (
        <path d="M16.6 5.82A4.44 4.44 0 0 1 14 2h-3.5v13.67a2.9 2.9 0 1 1-2-2.75V9.3a6.5 6.5 0 1 0 5.5 6.42V8.75a7.9 7.9 0 0 0 4.6 1.47V6.7a4.4 4.4 0 0 1-2-.88Z" />
    )}
    {platform === "Threads" && (
        <>
            <path d="M12 21c-5.1 0-8-3.5-8-9s2.9-9 8-9c4.2 0 6.9 2.3 7.7 6.2" />
            <path d="M19.7 9.2c.2 1 .3 2.1.3 3.3 0 5-2.2 8.5-6.1 8.5-2.4 0-4-1.4-4-3.6 0-2.1 1.6-3.4 4.2-3.4 2.1 0 4 .7 5.8 2" />
            <path d="M19.7 9.2c-.8-2.1-2.7-3.2-5.1-3.2-2.7 0-4.5 1.5-4.5 3.7 0 2.1 1.8 3.4 4.3 3.4 2.1 0 3.9-.8 5.6-2.4" />
        </>
    )}
    {platform === "YouTube" && (
        <>
            <path d="M22 12s0-3.5-.45-5.18a2.7 2.7 0 0 0-1.9-1.9C17.97 4.46 12 4.46 12 4.46s-5.97 0-7.65.46a2.7 2.7 0 0 0-1.9 1.9C2 8.5 2 12 2 12s0 3.5.45 5.18a2.7 2.7 0 0 0 1.9 1.9c1.68.46 7.65.46 7.65.46s5.97 0 7.65-.46a2.7 2.7 0 0 0 1.9-1.9C22 15.5 22 12 22 12Z" />
            <path d="m10 15.5 5-3.5-5-3.5v7Z" />
        </>
    )}
    {platform === "Sitio web" && (
        <>
            <circle cx="12" cy="12" r="9.5" />
            <path d="M2.8 12h18.4M12 2.5c2.3 2.5 3.5 5.7 3.5 9.5s-1.2 7-3.5 9.5c-2.3-2.5-3.5-5.7-3.5-9.5s1.2-7 3.5-9.5Z" />
        </>
    )}
</svg>
