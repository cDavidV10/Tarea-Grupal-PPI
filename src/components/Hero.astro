---
---

<section class="hero" id="inicio">
    <img
        class="escena foto"
        alt=""
        fetchpriority="high"
        src="/images/hero-image.webp"
    />
    <div class="tinte"></div>
    <div class="sombra"></div>
    <div class="contenido">
        <p class="eyebrow">Donde se vive la cultura del motor</p>
        <h1>La cultura del motor en El Salvador</h1>
        <p class="lead">
            La escena automotriz, en un solo lugar: eventos, pistas, noticias y
            clubes.
        </p>
    </div>
</section>

<style>
    .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        align-items: center;
        overflow: hidden;
        width: 100%;
        background: #211718;
        color: #f9f7f6;
        font-weight: 400;
        line-height: 1.6;
    }

    .escena {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 62% 50%;
    }

    .foto {
        filter: saturate(0.7) contrast(1.08) brightness(0.9);
    }

    .tinte {
        position: absolute;
        inset: 0;
        pointer-events: none;
        mix-blend-mode: multiply;
        background: linear-gradient(
            135deg,
            rgba(60, 71, 85, 0.65),
            rgba(33, 23, 24, 0.35) 55%,
            rgba(176, 3, 3, 0.25)
        );
    }

    .sombra {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(
                90deg,
                rgba(33, 23, 24, 0.9) 0%,
                rgba(33, 23, 24, 0.55) 45%,
                rgba(33, 23, 24, 0.08) 100%
            ),
            linear-gradient(to top, #211718 0%, rgba(33, 23, 24, 0) 32%);
    }

    .contenido {
        position: relative;
        max-width: 72rem;
        margin: 0 auto;
        width: 100%;
        padding: 7rem 1.5rem 6rem;
    }

    .eyebrow {
        font-weight: 500;
        font-size: clamp(16px, 2.2vw, 20px);
        letter-spacing: 0.02em;
        line-height: 1.2;
        color: var(--vintage-charm, #c5b1a6);
        margin: 0 0 16px;
    }

    .hero h1 {
        font-weight: 700;
        font-size: clamp(40px, 7.5vw, 96px);
        line-height: 1.02;
        letter-spacing: -0.03em;
        max-width: 14ch;
        margin: 0;
    }

    .lead {
        max-width: 44ch;
        font-size: clamp(17px, 2vw, 20px);
        color: #c5b1a6;
        margin: 24px 0 32px;
    }

    @media (max-width: 720px) {
        .hero {
            align-items: flex-end;
        }

        .sombra {
            background: linear-gradient(
                to top,
                #211718 0%,
                rgba(33, 23, 24, 0.82) 45%,
                rgba(33, 23, 24, 0.35) 100%
            );
        }
    }
</style>