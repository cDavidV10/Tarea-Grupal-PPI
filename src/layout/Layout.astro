---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../../public/styles/global.css";

interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image } = Astro.props;

const canonicalURL = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : undefined;
const pageURL = canonicalURL ?? Astro.url;
const imagenURL = image ? new URL(image, Astro.url) : undefined;
const tieneHero = Astro.slots.has("hero");
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="robots" content="index, follow" />
        <meta name="googlebot" content="index, follow" />
        <meta name="author" content="Car Meet SV" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />

        <meta
            name="google-site-verification"
            content="eJAMsc3WCL8ZZO832eySoN9beijMxur3LRQV3lCjq_k"
        />

        {canonicalURL && <link rel="canonical" href={canonicalURL} />}

        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />

        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_SV" />
        <meta property="og:site_name" content="Car Meet SV" />
        <meta property="og:url" content={pageURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {imagenURL && <meta property="og:image" content={imagenURL} />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={pageURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {imagenURL && <meta name="twitter:image" content={imagenURL} />}
    </head>
    <body>
        <Navbar />
        <main class:list={["principal", { "sin-hero": !tieneHero }]}>
            <slot name="hero" />
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .principal {
        flex: 1;
    }

    .principal.sin-hero {
        padding-top: calc(4rem + 1px);
    }
</style>