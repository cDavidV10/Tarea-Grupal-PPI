---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../../public/styles/global.css";

interface Props {
    title: string;
    description: string;
    image?: string;
    keywords?: string;
}

const { title, description, image, keywords } = Astro.props;
const tituloPagina = title.endsWith(" - PPI") ? title : `${title} - PPI115 - 2026`;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const pageLabels: Record<string, string> = {
    "/about": "Sobre nosotros",
    "/clubes": "Clubes",
    "/contacto": "Contacto",
    "/eventos": "Eventos",
    "/noticias": "Noticias",
    "/pistas": "Pistas",
    "/suscribete": "Suscríbete",
    "/404": "Página no encontrada",
};
const pathSegments = pathname.split("/").filter(Boolean);
const categoryPath =
    pathSegments.length > 1 &&
    ["clubes", "eventos", "noticias"].includes(pathSegments[0])
        ? `/${pathSegments[0]}`
        : undefined;
const categoryLabel = categoryPath ? pageLabels[categoryPath] : undefined;
const currentPageLabel =
    pageLabels[pathname] ??
    title.split("|")[0].trim() ??
    pathSegments.at(-1)?.replace(/-/g, " ") ??
    "Página";
const defaultKeywords =
    "Car Meeting SV, eventos de autos, comunidad automotriz, tuning, carros El Salvador, clubes automotrices, reuniones de autos, cultura automotriz, pistas, autos clásicos, autos deportivos";

const pageImageMap: Record<string, string> = {
    "/": "/images/hero-image.webp",
    "/index": "/images/hero-image.webp",
    "/eventos": "/images/eventos/noche-de-echadas.webp",
    "/noticias": "/images/portadas/noticia.webp",
    "/clubes": "/images/portadas/clubes.webp",
    "/pistas": "/images/portadas/pista.webp",
    "/about": "/images/portadas/clubes.webp",
    "/contacto": "/images/portadas/parking.webp",
};

const resolvedImage = image ?? pageImageMap[Astro.url.pathname] ?? "/images/hero-image.webp";
const canonicalPath = pathname === "/" ? "/" : `${pathname}/`;
const canonicalURL = Astro.site
    ? new URL(canonicalPath, Astro.site)
    : undefined;
const pageURL = canonicalURL ?? Astro.url;
const imagenURL = resolvedImage ? new URL(resolvedImage, Astro.url) : undefined;
const tieneHero = Astro.slots.has("hero");
const siteURL = new URL("/", Astro.site ?? Astro.url);
const organizationId = `${siteURL}#organization`;
const websiteId = `${siteURL}#website`;
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            "@id": organizationId,
            name: "Car Meeting SV",
            url: siteURL,
            logo: {
                "@type": "ImageObject",
                url: new URL("/images/Logo.webp", siteURL),
            },
        },
        {
            "@type": "WebSite",
            "@id": websiteId,
            url: siteURL,
            name: "Car Meeting SV",
            inLanguage: "es-SV",
            publisher: { "@id": organizationId },
        },
        {
            "@type": "WebPage",
            "@id": `${pageURL}#webpage`,
            url: pageURL,
            name: tituloPagina,
            description,
            inLanguage: "es-SV",
            isPartOf: { "@id": websiteId },
            publisher: { "@id": organizationId },
            ...(imagenURL && {
                primaryImageOfPage: {
                    "@type": "ImageObject",
                    url: imagenURL,
                },
            }),
        },
        ...(pathname !== "/" && pathname !== "/index"
            ? [
                  {
                      "@type": "BreadcrumbList",
                      itemListElement: [
                          {
                              "@type": "ListItem",
                              position: 1,
                              name: "Inicio",
                              item: siteURL,
                          },
                          ...(categoryPath && categoryLabel
                              ? [
                                    {
                                        "@type": "ListItem",
                                        position: 2,
                                        name: categoryLabel,
                                        item: new URL(categoryPath, siteURL),
                                    },
                                ]
                              : []),
                          {
                              "@type": "ListItem",
                              position: categoryPath ? 3 : 2,
                              name: currentPageLabel,
                              item: pageURL,
                          },
                      ],
                  },
              ]
            : []),
    ],
};
---

<!doctype html>
<html lang="es">
    <head>
       <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-4LEHJ58669"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-4LEHJ58669');
        </script>
        <meta charset="utf-8" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="48x48" href="/images/logo-48x48.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/images/logo-192x192.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="index, follow" />
        <meta name="googlebot" content="index, follow" />
        <meta name="author" content="Car Meeting SV" />
        <meta name="institution" content="Universidad de El Salvador" />
        <meta name="school" content="Escuela de Ingeniería" />
        <meta name="program" content="Ingeniería de Sistemas Informáticos" />
        <meta name="course" content="Programación Para Internet (PPI)" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />

        <meta
            name="google-site-verification"
            content="eJAMsc3WCL8ZZO832eySoN9beijMxur3LRQV3lCjq_k"
        />

        {canonicalURL && <link rel="canonical" href={canonicalURL} />}

        <title>{tituloPagina}</title>
        <meta name="title" content={tituloPagina} />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords ?? defaultKeywords} />

        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_SV" />
        <meta property="og:site_name" content="Car Meeting SV" />
        <meta property="og:url" content={pageURL} />
        <meta property="og:title" content={tituloPagina} />
        <meta property="og:description" content={description} />
        {imagenURL && <meta property="og:image" content={imagenURL} />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={pageURL} />
        <meta name="twitter:title" content={tituloPagina} />
        <meta name="twitter:description" content={description} />
        {imagenURL && <meta name="twitter:image" content={imagenURL} />}
        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
        ></script>
    </head>
    <body>
        <Navbar />
        <main class:list={["principal", { "sin-hero": !tieneHero }]}>
            {pathname !== "/" && pathname !== "/index" && (
                <nav class="migas" aria-label="Ruta de navegación">
                    <ol>
                        <li><a href="/">Inicio</a></li>
                        {categoryPath && categoryLabel && (
                            <li><a href={categoryPath}>{categoryLabel}</a></li>
                        )}
                        <li aria-current="page">{currentPageLabel}</li>
                    </ol>
                </nav>
            )}
            <slot name="hero" />
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .principal {
        flex: 1;
    }

    .principal.sin-hero {
        padding-top: 0;
    }

    .migas {
        padding-top: calc(4rem + 1px);
        border-bottom: 1px solid rgb(99 118 135 / 0.55);
        background-color: rgb(247 240 236 / 0.035);
    }

    .migas ol {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem;
        max-width: 72rem;
        margin: 0 auto;
        padding: 0.7rem 1.5rem;
        color: rgb(247 240 236 / 0.7);
        font-size: 0.9rem;
        list-style: none;
    }

    .migas li + li::before {
        margin-right: 0.55rem;
        color: var(--all-systems-red, #b00303);
        content: "›";
    }

    .migas a {
        color: var(--vintage-charm, #f7f0ec);
        text-decoration: none;
    }

    .migas a:hover,
    .migas a:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    @media (max-width: 520px) {
        .migas ol {
            padding-inline: 1rem;
        }
    }
</style>